// Bridge: Quarto YAML (planner:) -> Typst article() arguments.
// Do not edit this file for normal use; edit blank.qmd / filled.qmd instead.
#show: doc => article(
  project-name: [$if(planner.project)$$planner.project$$endif$],
  team-lead: [$if(planner.team-lead)$$planner.team-lead$$endif$],
  objective: [$if(planner.objective)$$planner.objective$$endif$],
  due-date: [$if(planner.due-date)$$planner.due-date$$endif$],
  milestones: (
$for(planner.milestones)$
    (
      name: [$planner.milestones.name$],
      progress: $if(planner.milestones.progress)$$planner.milestones.progress$$else$0$endif$,
      due: [$if(planner.milestones.due)$$planner.milestones.due$$endif$],
      done: $if(planner.milestones.done)$true$else$false$endif$,
    ),
$endfor$
  ),
  timeline: (
$for(planner.timeline)$
    (
      segment: [$planner.timeline.segment$],
      start: $if(planner.timeline.start)$$planner.timeline.start$$else$0$endif$,
      end: $if(planner.timeline.end)$$planner.timeline.end$$else$0$endif$,
    ),
$endfor$
  ),
  tasks: (
$for(planner.tasks)$
    (
      task: [$planner.tasks.task$],
      owner: [$if(planner.tasks.owner)$$planner.tasks.owner$$endif$],
      start: [$if(planner.tasks.start)$$planner.tasks.start$$endif$],
      end: [$if(planner.tasks.end)$$planner.tasks.end$$endif$],
      done: $if(planner.tasks.done)$true$else$false$endif$,
    ),
$endfor$
  ),
  in-scope: (
$for(planner.in-scope)$
    [$planner.in-scope$],
$endfor$
  ),
  out-of-scope: (
$for(planner.out-of-scope)$
    [$planner.out-of-scope$],
$endfor$
  ),
  success-criteria: (
$for(planner.success-criteria)$
    [$planner.success-criteria$],
$endfor$
  ),
  deliverables: (
$for(planner.deliverables)$
    [$planner.deliverables$],
$endfor$
  ),
  notes: (
$for(planner.notes)$
    [$planner.notes$],
$endfor$
  ),
  appendix: $if(planner.include-appendix)$true$else$false$endif$,
  doc,
)
